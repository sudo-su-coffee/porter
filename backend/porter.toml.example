# ============================================================================
#  Porter — example runtime configuration (backend/).
#
#  Copy this to `porter.toml` (or point PORTER_CONFIG at it) before running
#  `porter server`. Credentials are not stored here: migrations seed the
#  initial RBAC account and the process receives bootstrap/encryption secrets
#  through PORTER_BOOTSTRAP_ADMIN_PASSWORD and PORTER_SECRET_KEY.
#
#  REQUIRED for an operational deployment:
#    [database] url            (or PORTER_DATABASE_URL)
#    real vmlinux + rootfs.ext4 artifacts at the firecracker paths below
# ============================================================================

# ---------------------------------------------------------------------------
[server]
# listen_addr — host:port the control-plane API + embedded dashboard bind to.
listen_addr = ":8080"
#   Override: PORTER_LISTEN_ADDR

# volumes_dir — where real persistent volume data lives (one dir per volume
# with a sparse data.img). Defaults to ./volumes.
# volumes_dir = "volumes"
#   Override: PORTER_VOLUMES_DIR

# base_domain — DNS suffix Porter appends when auto-creating per-service
# domains, e.g. `<name>.porter.test`.
base_domain = "porter.test"
#   Override: PORTER_BASE_DOMAIN

# rate_limit_per_min — optional per-client-IP request cap on the control
# plane (0 disables). Apply on public endpoints.
# rate_limit_per_min = 120
#   Override: PORTER_RATE_LIMIT_PER_MIN

# ---------------------------------------------------------------------------
[database]
# url — PostgreSQL connection string. PostgreSQL is the required backend.
url = "postgres://porter:porter@localhost:5432/porter?sslmode=disable"
#   Override: PORTER_DATABASE_URL

# auto_migrate — run pending SQL migrations (backend/migrations/*.sql) at startup.
auto_migrate = true
#   Override: PORTER_AUTO_MIGRATE  (true/1/yes/on | false/0/no/off)

# ---------------------------------------------------------------------------
[firecracker]
# runtime_mode — direct Firecracker is the only backend execution mode.
# Deployments must resolve to a host kernel + rootfs.ext4 artifact.
runtime_mode = "direct"
#   Override: PORTER_RUNTIME_MODE

# base_image_ref — persisted image-catalog reference resolved before boot.
base_image_ref = "base://default"

# api_socket_dir — parent directory for one Firecracker API Unix socket per VM.
api_socket_dir = "/run/porter/firecracker"
#   Override: PORTER_FIRECRACKER_API_SOCKET_DIR

# snapshot_dir — durable full snapshot state and guest-memory files.
snapshot_dir = "/var/lib/porter/snapshots"
#   Override: PORTER_FIRECRACKER_SNAPSHOT_DIR

# kernel_image — shared microkernel (vmlinux) for every microVM.
# Provision it with `porter kernel set <path|URL>`.
kernel_image = "/var/lib/porter/vmlinux"
#   Override: PORTER_KERNEL_IMAGE

# rootfs_path — default rootfs.ext4 used when a VM has no per-VM rootfs_path.
rootfs_path = "/var/lib/porter/rootfs.ext4"
#   Override: PORTER_ROOTFS_PATH

# firecracker_bin — direct Firecracker VMM binary.
firecracker_bin = "firecracker"
#   Override: PORTER_FIRECRACKER_BIN

# logs_dir — directory where per-VM stdio logs are written.
logs_dir = "/var/log/porter"
#   Override: PORTER_LOGS_DIR

# images_dir — directory of image-catalog manifests (vms/images/*.json).
images_dir = "vms/images"
#   Override: PORTER_IMAGES_DIR

# custom_images_dir — where user-uploaded microVM .zip images (rootfs.ext4 +
# vmlinux) are unpacked.
custom_images_dir = "vms/custom"
#   Override: PORTER_CUSTOM_IMAGES_DIR

[gateway]
# enabled — host-routing reverse proxy (Vercel-style) on its own listener.
# Routes by Host header to the healthy replica pool and logs every request to
# the traffic store (dashboard → Traffic).
enabled = false
#   Override: PORTER_GATEWAY_ENABLED

# listen_addr — the traffic-facing listener. Keep separate from the control
# plane (:8080). :80 needs root (or a port-forward on WSL).
listen_addr = ":80"
#   Override: PORTER_GATEWAY_LISTEN_ADDR

# ---------------------------------------------------------------------------
[dns]
# enabled — resolve <svc>.<project>.local and <svc>-<n>.<project>.local
# replica hostnames for the gateway.
enabled = true
#   Override: PORTER_DNS_ENABLED

# gateway_ip — public IP address for DNS A records (*.baseDomain).
# Used by the authoritative DNS server to route traffic to the gateway.
gateway_ip = "127.0.0.1"
#   Override: PORTER_GATEWAY_IP

# ---------------------------------------------------------------------------
[tls]
# enabled — automatic HTTPS via Let's Encrypt ACME.
# Requires acme_email and a valid base_domain.
enabled = false
#   Override: PORTER_TLS_ENABLED

# acme_email — email for Let's Encrypt account (receives expiry warnings).
acme_email = ""
#   Override: PORTER_ACME_EMAIL

# ---------------------------------------------------------------------------
[health]
# enabled — per-VM healthcheck + auto-replace of unhealthy VMs.
enabled = true
#   Override: PORTER_HEALTH_ENABLED

# ---------------------------------------------------------------------------
[ssh]
# enabled — SSH gateway (short-lived CA-signed user certs). Direct Firecracker
# currently requires a future guest-vsock agent for interactive exec; leave false.
enabled = false
#   Override: PORTER_SSH_ENABLED

# listen_addr — SSH gateway listener.
listen_addr = ":2222"
#   Override: PORTER_SSH_LISTEN_ADDR

# ---------------------------------------------------------------------------
[autoscale]
# enabled — horizontal autoscaler: polls project load and adjusts the replica
# pool per each project's AutoscalePolicy (min/max replicas, CPU target).
enabled = false
#   Override: PORTER_AUTOSCALE_ENABLED

# ---------------------------------------------------------------------------
[cache]
# enabled — optional Redis read-through cache for hot read paths.
enabled = false
#   Override: PORTER_CACHE_ENABLED

# url — Redis connection string (e.g. redis://localhost:6379/0).
url = "redis://localhost:6379/0"
#   Override: PORTER_CACHE_URL

# ttl_seconds — how long cached reads stay fresh before falling through to PG.
ttl_seconds = 15
#   Override: PORTER_CACHE_TTL_SECONDS

# ---------------------------------------------------------------------------
[notify]
# enabled — SMTP email notifications for alerts and operational events.
# When false (default) the mailer is a harmless no-op; the API still works.
enabled = false
#   Override: PORTER_NOTIFY_ENABLED

# smtp_host — SMTP relay hostname (e.g. smtp.example.com).
# smtp_host = "smtp.example.com"
#   Override: PORTER_SMTP_HOST

# smtp_port — SMTP port (587 is the common submission port).
# smtp_port = 587
#   Override: PORTER_SMTP_PORT

# smtp_user / smtp_password — SMTP AUTH credentials (may be empty for relays
# that accept open submission).
# smtp_user = ""
# smtp_password = ""
#   Override: PORTER_SMTP_USER / PORTER_SMTP_PASSWORD

# from — envelope From address for outgoing alert mail.
# from = "porter@example.com"
#   Override: PORTER_SMTP_FROM

# default_to — fallback recipient when an alert has no explicit destination
# (per-user email + opt-in is a planned follow-up).
# default_to = "ops@example.com"
#   Override: PORTER_NOTIFY_DEFAULT_TO
