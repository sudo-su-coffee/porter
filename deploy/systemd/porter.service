# Porter control plane — systemd unit.
# Install with:
#   sudo cp deploy/systemd/porter.service /etc/systemd/system/porter.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now porter
#
# The unit runs the single Porter binary (`porter server`) built by `make
# backend`. Optional secrets/env live in /etc/porter/porter.env
# (EnvironmentFile, "-" = optional); a default PostgreSQL DSN is provided via
# Environment so the unit starts even without an env file.

[Unit]
Description=Porter control plane (Firecracker microVM PaaS)
Documentation=file:///usr/local/share/doc/porter/README.md
After=network-online.target postgresql.service containerd.service
Wants=network-online.target
RequiresMountsFor=/var/lib/porter

[Service]
Type=simple
User=porter
Group=porter
WorkingDirectory=/etc/porter

# Optional override file for secrets (PORTER_API_TOKEN, PORTER_ADMIN_PASSWORD, ...).
# "-" prefix means "ignore if missing". Values here win over Environment= below.
EnvironmentFile=-/etc/porter/porter.env
# Default PostgreSQL DSN; override via /etc/porter/porter.env or by editing.
Environment=PORTER_DATABASE_URL=postgres://porter:porter@localhost:5432/porter?sslmode=disable
Environment=PORTER_AUTO_MIGRATE=true

# Full path + config: cmd/server is the built entrypoint (see Makefile backend target).
ExecStart=/usr/local/bin/porter server -config /etc/porter/porter.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# Hardening — the control plane only needs its own dirs + the containerd socket.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/porter /var/log/porter

[Install]
WantedBy=multi-user.target
