{
  "title": "Porter Control Plane Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(porter_http_requests_total[5m]))", "legendFormat": "requests/s" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(porter_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "type": "stat",
      "title": "Running replicas",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(porter_replicas{state=\"running\"})", "legendFormat": "running" }]
    },
    {
      "type": "stat",
      "title": "Failed deployments",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "sum(increase(porter_deployments_total{status=\"failed\"}[30m]))", "legendFormat": "failed" }]
    },
    {
      "type": "stat",
      "title": "Connected event streams",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "porter_events_connected", "legendFormat": "streams" }]
    }
  ]
}
