# ============================================================================
#  Porter — example runtime configuration.
#
#  Copy this to `porter.toml` (or point PORTER_CONFIG at it) and edit the
#  secrets before running `porter server`. A missing file is not an error:
#  every key has a built-in default and can be overridden by a PORTER_* env
#  var (noted inline next to each key), so this file is optional.
#
#  REQUIRED (Porter refuses to start without these):
#    [server] api_token
#    [admin]  password
#    [database] url   (default below is applied if unset)
# ============================================================================

# ---------------------------------------------------------------------------
[server]
# listen_addr — host:port the control-plane API + embedded dashboard bind to.
listen_addr = ":8080"
#   Override: PORTER_LISTEN_ADDR

# base_domain — DNS suffix Porter appends when auto-creating per-service
# domains, e.g. `<name>.porter.test`.
base_domain = "porter.test"
#   Override: PORTER_BASE_DOMAIN

# api_token — bearer token required on every protected /api/* request.
# This is the control-plane secret; in production serve Porter on a trusted
# network only and inject the value via PORTER_API_TOKEN.
api_token = "change-me"
#   Override: PORTER_API_TOKEN

# ---------------------------------------------------------------------------
[database]
# ---------------------------------------------------------------------------
# url — PostgreSQL connection string for the state store (VMs, projects,
# image catalog, logs). PostgreSQL is the required backend, not SQLite.
url = "postgres://porter:porter@localhost:5432/porter?sslmode=disable"
#   Override: PORTER_DATABASE_URL

# auto_migrate — run pending SQL migrations from /migrations at startup.
auto_migrate = true
#   Override: PORTER_AUTO_MIGRATE  (true/1/yes/on | false/0/no/off)

# ---------------------------------------------------------------------------
# [firecracker] — Linux-host VM wiring. Porter boots OCI images via containerd
# + the aws.firecracker shim; the kernel/rootfs paths in this section are
# consumed by the host's /etc/containerd/firecracker-runtime.json (and by the
# `porter kernel` subcommand), not by Porter at runtime. The containerd settings
# below are the ones Porter actually uses.
# ---------------------------------------------------------------------------
# containerd_socket — Unix socket for the containerd daemon Porter talks to.
containerd_socket = "/run/containerd/containerd.sock"
#   Override: PORTER_CONTAINERD_SOCKET

# snapshotter — containerd snapshotter images are pulled/unpacked into.
snapshotter = "devmapper"
#   Override: PORTER_SNAPSHOTTER

# namespace — containerd namespace Porter's images live in.
namespace = "porter"
#   Override: PORTER_NAMESPACE

# kernel_image — shared microkernel (vmlinux) for every microVM. Provision it
# with `porter kernel set <path|URL>`; keep this path pointing at the copy the
# host shim uses.
kernel_image = "/var/lib/porter/vmlinux"
#   Override: PORTER_KERNEL_IMAGE

# logs_dir — directory where per-VM stdio logs are written.
logs_dir = "/var/log/porter"
#   Override: PORTER_LOGS_DIR

# simulate — true switches Porter into dev/demo mode: the VM lifecycle is
# faked and no containerd is needed. Leave false on a real host.
# simulate = false
#   Override: PORTER_SIMULATE  (true/1/yes/on | false/0/no/off)

# rootfs_path / firecracker_bin — legacy direct-Firecracker fields kept for
# compatibility; the containerd-backed build reads them from the shim config.
# Overrides: PORTER_ROOTFS_PATH, PORTER_FIRECRACKER_BIN

# images_dir — directory of image-catalog manifests (vms/images/*.json).
# images_dir = "vms/images"
#   Override: PORTER_IMAGES_DIR

# ---------------------------------------------------------------------------
# [admin] — the single bootstrap control-plane account. Login to the dashboard
# gates a bearer token back. There is no user database.
# ---------------------------------------------------------------------------
# username — admin login name.
username = "admin"
#   Override: PORTER_ADMIN_USERNAME

# password — the admin password. The current build compares it in constant
# time via crypto/subtle; pass it with PORTER_ADMIN in production rather than
# writing it to disk (config.Config reads the `password` key; importing an
# argon2id/BCrypt hash is a planned hardening).
password = "change-me"
#   Override: PORTER_ADMIN_PASSWORD
# password_hash = "$argon2id$..."   # future: never store plaintext in prod —
# only PORTER_ADMIN_PASSWORD is read today.