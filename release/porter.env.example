# The installer writes this as /var/porter/porter.env with mode 0640.
# Never commit real values.
# The installer generates PORTER_BOOTSTRAP_ADMIN_PASSWORD once when absent.
PORTER_DATABASE_URL=postgres://porter:change-me@127.0.0.1:5432/porter?sslmode=disable
PORTER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-secret
PORTER_SECRET_KEY=replace-with-a-long-random-secret
PORTER_LISTEN_ADDR=:8080
PORTER_RUNTIME_MODE=direct
PORTER_FIRECRACKER_BIN=/opt/porter/bin/firecracker
PORTER_FIRECRACKER_API_SOCKET_DIR=/run/porter/firecracker
PORTER_KERNEL_IMAGE=/var/lib/porter/base-images/default/vmlinux
PORTER_ROOTFS_PATH=/var/lib/porter/base-images/default/rootfs.ext4
PORTER_LOGS_DIR=/var/log/porter
PORTER_IMAGES_DIR=/var/lib/porter/images
PORTER_CUSTOM_IMAGES_DIR=/var/lib/porter/custom
PORTER_VOLUMES_DIR=/var/lib/porter/volumes
PORTER_HEALTH_ENABLED=true
# External observability is disabled by default. Keep provider credentials out
# of this file and inject them through the protected environment file instead.
PORTER_METRICS_ENABLED=false
PORTER_OTEL_ENABLED=false
PORTER_OTEL_SERVICE_NAME=porter-control-plane
PORTER_SENTRY_ENABLED=false
PORTER_SENTRY_DSN=
PORTER_SENTRY_ENVIRONMENT=production
