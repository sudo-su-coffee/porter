{
  "id": "nginx-docker",
  "name": "Nginx",
  "type": "docker",
  "description": "High-performance HTTP server and reverse proxy. Pulls nginx:alpine from Docker Hub and runs inside a Firecracker MicroVM.",
  "source": "nginx:alpine",
  "rootfs": "vms/rootfs.ext4",
  "kernel": "vms/vmlinux",
  "vcpus": 1,
  "mem_mib": 128,
  "ports": [
    {
      "container_port": 80,
      "protocol": "tcp"
    }
  ],
  "env": {},
  "tags": [
    "web",
    "http",
    "proxy",
    "docker"
  ],
  "logo": "🌐"
}